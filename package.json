{
  "name": "notintotech-website",
  "version": "1.0.0",
  "description": "This is repository for Not Into Tech website as digital platform. The website will be utilized for organization branding and releasing products.",
  "main": "server-local.js",
  "scripts": {
    "dev:css": "npx @tailwindcss/cli -i ./src/public/main.css -o ./src/public/output.css --watch",
    "dev:server": "nodemon index.js",
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:server\"",
    "vercel-build": "prisma generate",
    "postinstall": "prisma generate",
    "build": "prisma generate && node server.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/cli": "^4.1.11",
    "dompurify": "^3.0.6",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-validator": "^7.3.1",
    "jsdom": "^23.0.0",
    "mongoose": "^8.19.1",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.1.11"
  },
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Not-Into-Tech/NotIntoTech-Website.git"
  },
  "bugs": {
    "url": "https://github.com/Not-Into-Tech/NotIntoTech-Website/issues"
  },
  "homepage": "https://github.com/Not-Into-Tech/NotIntoTech-Website#readme",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "prisma": "^6.19.3"
  }
}
