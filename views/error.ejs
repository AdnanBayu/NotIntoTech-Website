<!DOCTYPE html>
<html lang="en">
<%- include('components/head', { text: 'Error' }) %>

    <body class="bg-[#010C13]">

        <!-- Content Wrapper -->
        <div class="relative z-20">

            <!-- Header Website -->
            <section>
                <%- include('components/header') %>
            </section>

            <!-- Main Content -->
            <section>
                <canvas id="noiseCanvas" class="fixed top-0 left-0 w-full h-full z-0 opacity-40"></canvas>

                <main
                    class="
                        relative flex flex-col z-10 
                        items-center justify-center px-6 py-12
                        min-h-screen
                        pointer-events-none
                    ">
                    <!-- Main Text -->
                    <div class="
                        -mt-6 sm:-mt-10 md:-mt-14 px-4 mb-15
                        relative z-20
                    ">
                        <h2 class="text-2xl sm:text-3xl md:text-5xl font-bold mb-3 text-white drop-shadow-lg">
                            Page Not <span class="text-emerald-500 italic">Found</span>
                        </h2>
                        <p class="max-w-md mx-auto text-slate-400 text-xs sm:text-sm md:text-base leading-relaxed">
                            This directory is currently unreachable. <br class="hidden sm:block">
                            Our models suggest returning to a known node below.
                        </p>
                    </div>

                    <!-- Suggest Card -->
                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 w-full max-w-5xl pointer-events-auto">

                        <!-- Articles Card -->
                        <a href="/insights"
                            class="group relative p-6 md:p-8 rounded-2xl bg-[##010C13]/60 backdrop-blur-xl border border-[#154D41]/20 hover:border-[#154D41]/60 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_0_30px_-10px_rgba(21,77,65,0.5)]">
                            <h3 class="text-lg md:text-xl font-bold text-white mb-2">Data Articles</h3>
                            <p class="text-xs md:text-sm text-slate-500">Industry research and deep-dive analytical
                                insights.</p>
                        </a>

                        <!-- Datasets Card -->
                        <a href="/data"
                            class="sm:col-span-2 md:col-span-1 group relative p-6 md:p-8 rounded-2xl bg-[##010C13]/60 backdrop-blur-xl border border-[#154D41]/20 hover:border-[#154D41]/60 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_0_30px_-10px_rgba(21,77,65,0.5)]">
                            <h3 class="text-lg md:text-xl font-bold text-white mb-2">Datasets</h3>
                            <p class="text-xs md:text-sm text-slate-500">Explore curated datasets ready for analysis and
                                training.</p>
                        </a>

                        <!-- AI Development Card -->
                        <a href="/ai"
                            class="group relative p-6 md:p-8 rounded-2xl bg-[##010C13]/60 backdrop-blur-xl border border-[#154D41]/20 hover:border-[#154D41]/60 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_0_30px_-10px_rgba(21,77,65,0.5)]">
                            <h3 class="text-lg md:text-xl font-bold text-white mb-2">Artificial Intelligence</h3>
                            <p class="text-xs md:text-sm text-slate-500">Latest findings in neural networks and machine
                                learning.</p>
                        </a>


                    </div>

                    <!-- Back to Home -->
                    <div class="
                        mt-12 md:mt-16 
                        pointer-events-auto
                    ">
                        <a href="/"
                            class="
                                flex 
                                items-center gap-3 
                                text-emerald-500 font-mono text-[10px] md:text-xs uppercase tracking-[0.3em] 
                                hover:text-emerald-300 transition-all duration-300
                            ">
                            Back to Home
                        </a>
                    </div>
                </main>
            </section>

        </div>

        <script src="script.js"></script>
        <script>
            const canvas = document.getElementById('noiseCanvas');
            const ctx = canvas.getContext('2d');
            let particles = [];
            let w, h;

            const config = {
                particleColor: 'rgba(21, 77, 65, 0.4)', // Using brand emerald
                particleCount: 1500,
                noiseSpeed: 0.8
            };

            function init() {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
                particles = [];

                // Adjust density based on screen size
                const count = w < 768 ? config.particleCount / 3 : config.particleCount;

                for (let i = 0; i < count; i++) {
                    particles.push({
                        x: Math.random() * w,
                        y: Math.random() * h,
                        size: Math.random() * 1.5,
                        vx: (Math.random() - 0.5) * config.noiseSpeed,
                        vy: (Math.random() - 0.5) * config.noiseSpeed,
                        alpha: Math.random()
                    });
                }
            }

            function drawNoise() {
                // Faint tail effect to simulate motion blur
                ctx.fillStyle = 'rgba(1, 12, 19, 0.2)';
                ctx.fillRect(0, 0, w, h);

                for (let p of particles) {
                    // Update position with random jitter
                    p.x += p.vx + (Math.random() - 0.5) * 0.5;
                    p.y += p.vy + (Math.random() - 0.5) * 0.5;

                    // Screen wrapping
                    if (p.x < 0) p.x = w;
                    if (p.x > w) p.x = 0;
                    if (p.y < 0) p.y = h;
                    if (p.y > h) p.y = 0;

                    // Occasional alpha flicker
                    if (Math.random() > 0.98) p.alpha = Math.random();

                    ctx.beginPath();
                    ctx.fillStyle = `rgba(21, 77, 65, ${p.alpha * 0.5})`;
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                }

                // High-frequency Grain Overlay
                // We draw a few random "pixels" every frame to simulate digital static
                for (let i = 0; i < 500; i++) {
                    const gx = Math.random() * w;
                    const gy = Math.random() * h;
                    ctx.fillStyle = Math.random() > 0.5 ? 'rgba(255,255,255,0.03)' : 'rgba(21,77,65,0.05)';
                    ctx.fillRect(gx, gy, 1, 1);
                }

                requestAnimationFrame(drawNoise);
            }

            window.addEventListener('resize', init);

            init();
            drawNoise();
        </script>

    </body>

</html>