<!-- Zone to input user message -->
<form id="chat-form" class="
    bg-white 
    flex gap-2 p-2
    rounded-2xl
    w-3/4
    mx-auto my-4
    transition-all duration-500 
    hover:ring-5 ring-dark-teal/80
    hover:-translate-y-1
">

    <input id="chat-input" type="text" placeholder="Ask about tech, competition, business..." class="
            flex-grow
            focus:outline-none
            px-4 py-2
        " autocomplete="off">

    <button type="submit" class="
        bg-dark-teal 
        p-3 
        rounded-xl 
        transition-transform 
        hover:scale-105 active:scale-95 
    ">
        <i data-lucide="send" class="text-white font-medium"></i>
    </button>

</form>