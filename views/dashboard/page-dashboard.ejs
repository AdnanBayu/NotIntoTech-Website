<!DOCTYPE html>
<html lang="en">
<%- include('../components/head', { text: 'Admin Hub' }) %>

  <body class="bg-[#010C13] text-white min-h-screen font-sans selection:bg-[#8EF0DD] selection:text-[#154D41]">

    <%- include('components/shared') %>
      <%- include('components/lockscreen') %>

        <!-- Header Website -->
        <section class="mb-24">
          <%- include('../components/header') %>
        </section>

        <!-- Content Wrapper -->
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 relative">

          <!-- Main Dashboard UI -->
          <div id="dashboard-content" class="hidden opacity-0 transition-opacity duration-500">

            <!-- Header title -->
            <header
              class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 border-b border-white/10 pb-6">
              <div>
                <h1 class="text-3xl font-extrabold tracking-tight">Admin Console</h1>
                <p class="text-white/60 mt-1">Publish, update, and manage insights articles and datasets.</p>
              </div>
              <div class="flex items-center gap-3">
                <button onclick="logout()"
                  class="px-4 py-2 border border-white/10 hover:border-red-500/50 hover:bg-red-500/10 text-white/70 hover:text-white rounded-xl text-sm font-medium transition duration-300">
                  Disconnect
                </button>
              </div>
            </header>

            <!-- Tabs navigation -->
            <div class="flex border-b border-white/10 mb-8 p-1 bg-neutral-900/60 rounded-xl max-w-md">
              <button onclick="switchTab('datasets')" id="tab-btn-datasets"
                class="flex-1 py-2.5 px-4 text-center rounded-lg text-sm font-bold transition-all duration-300 bg-[#8EF0DD] text-[#154D41]">
                Datasets
              </button>
              <button onclick="switchTab('articles')" id="tab-btn-articles"
                class="flex-1 py-2.5 px-4 text-center rounded-lg text-sm font-bold transition-all duration-300 text-white/60 hover:text-white hover:bg-white/5">
                Articles
              </button>
            </div>

            <%- include('components/datasets') %>
              <%- include('components/articles') %>

          </div>
        </div>

        <!-- Footer Website -->
        <%- include('../components/footer') %>

          <!-- Dashboard Tab Switching JS -->
          <script>
            let activeTab = 'datasets';

            // Tab switcher
            function switchTab(tab) {
              activeTab = tab;

              const tabDatasets = document.getElementById('tab-datasets');
              const tabArticles = document.getElementById('tab-articles');

              const btnDatasets = document.getElementById('tab-btn-datasets');
              const btnArticles = document.getElementById('tab-btn-articles');

              if (!tabDatasets || !tabArticles || !btnDatasets || !btnArticles) return;

              if (tab === 'datasets') {
                tabDatasets.classList.remove('hidden');
                tabArticles.classList.add('hidden');

                btnDatasets.className = "flex-1 py-2.5 px-4 text-center rounded-lg text-sm font-bold transition-all duration-300 bg-[#8EF0DD] text-[#154D41]";
                btnArticles.className = "flex-1 py-2.5 px-4 text-center rounded-lg text-sm font-bold transition-all duration-300 text-white/60 hover:text-white hover:bg-white/5";
              } else {
                tabDatasets.classList.add('hidden');
                tabArticles.classList.remove('hidden');

                btnArticles.className = "flex-1 py-2.5 px-4 text-center rounded-lg text-sm font-bold transition-all duration-300 bg-[#8EF0DD] text-[#154D41]";
                btnDatasets.className = "flex-1 py-2.5 px-4 text-center rounded-lg text-sm font-bold transition-all duration-300 text-white/60 hover:text-white hover:bg-white/5";
              }
            }
          </script>

  </body>

</html>