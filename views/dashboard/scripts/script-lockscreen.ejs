<script>
    let adminToken = '';

    // Check auth token on load
    document.addEventListener("DOMContentLoaded", () => {
        adminToken = localStorage.getItem('admin_token');
        if (adminToken) {
            showDashboard();
        } else {
            document.getElementById('lock-screen').classList.remove('hidden');
        }

        // Set up Drag and Drop event listeners on zones if helper is available
        if (typeof setupDragAndDrop === 'function') {
            setupDragAndDrop('ds-cover-dropzone', 'ds-cover-file', 'ds-cover-url', 'ds-cover-status', 'dataset');
            setupDragAndDrop('ds-file-dropzone', 'ds-data-file', 'ds-file-url', 'ds-file-status', 'dataset');
            setupDragAndDrop('art-image-dropzone', 'art-image-file', 'art-image-url', 'art-image-status', 'article');
        }
    });

    // Toggle password visibility on lock screen
    function toggleTokenVisibility() {
        const input = document.getElementById('admin-token');
        const icon = document.getElementById('eye-icon');
        if (!input || !icon) return;

        if (input.type === 'password') {
            input.type = 'text';
            icon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />`;
        } else {
            input.type = 'password';
            icon.innerHTML = `
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
      `;
        }
    }

    // Auth Form submission
    function handleAuth(event) {
        event.preventDefault();
        const token = document.getElementById('admin-token').value.trim();
        if (!token) return;

        adminToken = token;
        localStorage.setItem('admin_token', token);

        // Attempt showing dashboard
        showDashboard();
    }

    function showDashboard() {
        // Hide lock screen
        const lockScreen = document.getElementById('lock-screen');
        if (!lockScreen) return;

        lockScreen.classList.add('opacity-0');
        setTimeout(() => {
            lockScreen.classList.add('hidden');

            // Show content
            const content = document.getElementById('dashboard-content');
            if (content) {
                content.classList.remove('hidden');
                setTimeout(() => {
                    content.classList.remove('opacity-10');
                    content.classList.add('opacity-100');
                }, 50);
            }

            // Fetch Initial Data if fetch methods exist
            if (typeof fetchDatasets === 'function') fetchDatasets();
            if (typeof fetchArticles === 'function') fetchArticles();
        }, 300);
    }

    function logout() {
        localStorage.removeItem('admin_token');
        adminToken = '';

        // Hide content
        const content = document.getElementById('dashboard-content');
        if (content) {
            content.classList.remove('opacity-100');
            content.classList.add('opacity-10');
        }

        setTimeout(() => {
            if (content) {
                content.classList.add('hidden');
            }

            // Clear forms
            const authForm = document.getElementById('auth-form');
            if (authForm) authForm.reset();

            // Show lock screen
            const lockScreen = document.getElementById('lock-screen');
            if (lockScreen) {
                lockScreen.classList.remove('hidden');
                setTimeout(() => lockScreen.classList.remove('opacity-0'), 50);
            }
        }, 300);

        if (typeof showToast === 'function') {
            showToast('Successfully disconnected.', 'success');
        }
    }
</script>