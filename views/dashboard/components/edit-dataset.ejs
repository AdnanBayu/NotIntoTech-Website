<div id="dataset-modal" class="
  fixed inset-0 z-50 flex p-4
  items-center justify-center 
  bg-[#010C13]/80 backdrop-blur-sm 
  hidden
  transition-all duration-300
  ">
    <!-- Container box -->
    <div class="
        bg-neutral-900 border border-white/10 shadow-2xl opacity-0
        rounded-3xl w-full max-w-2xl max-h-[90vh] 
        relative overflow-y-auto 
        transform scale-95 transition-all duration-300
    ">
        <!-- Header edit -->
        <div class="
            flex justify-between items-center p-6 
            border-b border-white/10
        ">
            <h3 id="dataset-modal-title" class="text-xl font-bold">Add Dataset</h3>
            <!-- Close button -->
            <button onclick="closeDatasetModal()" class="text-white/40 hover:text-white transition">
                <i data-lucide="x"></i>
            </button>
        </div>

        <!-- Form edit -->
        <form id="dataset-form" onsubmit="submitDatasetForm(event)" class="p-6 space-y-6">
            <input type="hidden" id="dataset-id">

            <!-- Form title -->
            <div>
                <label for="ds-title" class="
                    block mb-2
                    text-xs font-semibold text-white/50 uppercase tracking-wider
                ">
                    Dataset Title
                </label>
                <input type="text" id="ds-title" required class="
                    w-full rounded-xl px-4 py-3
                    bg-black/40 border border-white/10 
                    text-white 
                    focus:outline-none focus:border-[#8EF0DD] transition-all
                " placeholder="e.g. E-Commerce Customer Analytics 2026">
            </div>

            <!-- Form description -->
            <div>
                <label for="ds-desc" class="
                    block mb-2
                    text-xs font-semibold text-white/50 uppercase tracking-wider
                ">
                    Description
                </label>
                <textarea id="ds-desc" rows="3" class="
                    w-full rounded-xl px-4 py-3 
                    bg-black/40 border border-white/10 
                    text-white 
                    focus:outline-none focus:border-[#8EF0DD] transition-all
                " placeholder="Enter a brief summary of the dataset..."></textarea>
            </div>

            <!-- Cover Image Upload & Input -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- URL input -->
                <div>
                    <label for="ds-cover-url" class="
                        block mb-2
                        text-xs font-semibold text-white/50 uppercase tracking-wider 
                    ">
                        Cover Image URL
                    </label>
                    <input type="text" id="ds-cover-url" class="
                        w-full rounded-xl px-4 py-3
                        bg-black/40 border border-white/10
                        text-white 
                        focus:outline-none focus:border-[#8EF0DD] transition-all
                    " placeholder="https://example.com/cover.jpg">
                </div>
                <!-- Upload input -->
                <div>
                    <label class="
                        block mb-2
                        text-xs font-semibold text-white/50 uppercase tracking-wider
                    ">
                        Upload Cover Image
                    </label>
                    <div id="ds-cover-dropzone" class="
                        border-2 border-dashed border-white/10 
                        rounded-xl p-3 
                        text-center 
                        cursor-pointer hover:border-[#8EF0DD] transition-all
                    " onclick="triggerFileInput('ds-cover-file')">
                        <span class="
                            text-xs text-white/40 
                            hover:text-white
                        " id="ds-cover-status">
                            Drag file here or click to browse
                        </span>
                        <input type="file" id="ds-cover-file" accept="image/*" class="hidden"
                            onchange="handleFileUpload(this, 'ds-cover-url', 'ds-cover-status', 'dataset')">
                    </div>
                </div>
            </div>

            <!-- File Upload & Input -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="ds-file-url" class="
                        block mb-2
                        text-xs font-semibold text-white/50 uppercase tracking-wider 
                    ">
                        Dataset File URL (Direct Download Link)
                    </label>
                    <input type="text" id="ds-file-url" required class="
                        w-full rounded-xl px-4 py-3
                        bg-black/40 border border-white/10
                        text-white 
                        focus:outline-none focus:border-[#8EF0DD] transition-all
                    " placeholder="https://example.com/data.csv">
                </div>
                <div>
                    <label class="
                        block mb-2
                        text-xs font-semibold text-white/50 uppercase tracking-wider
                    ">
                        Upload Dataset File (CSV, ZIP, XLSX)
                    </label>
                    <div id="ds-file-dropzone" class="
                        border-2 border-dashed border-white/10 
                        rounded-xl p-3 
                        text-center 
                        cursor-pointer hover:border-[#8EF0DD] transition-all
                    " onclick="triggerFileInput('ds-data-file')">
                        <span class="
                            text-xs text-white/40 
                            hover:text-white
                        " id="ds-file-status">
                            Drag file here or click to browse
                        </span>
                        <input type="file" id="ds-data-file" accept=".csv,.xlsx,.xls,.json,.zip" class="hidden"
                            onchange="handleFileUpload(this, 'ds-file-url', 'ds-file-status', 'dataset')">
                    </div>
                </div>
            </div>

            <div class="
                flex justify-end gap-3 pt-4
                border-t border-white/10
            ">
                <button type="button" onclick="closeDatasetModal()" class="
                    rounded-xl px-5 py-2.5 
                    border border-white/10 
                    transition hover:bg-white/5
                    text-white/70 font-medium text-sm 
                ">
                    Cancel
                </button>
                <button type="submit" class="
                    rounded-xl px-5 py-2.5 
                    bg-[#8EF0DD] 
                    hover:bg-[#8EF0DD]/90 transition
                    text-[#154D41] font-bold text-sm
                ">
                    Save Dataset
                </button>
            </div>
        </form>
    </div>
</div>