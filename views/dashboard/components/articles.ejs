<!-- Tab: Articles Management -->

<div id="tab-articles" class="hidden space-y-6">

  <!-- Subheader -->
  <div class="flex justify-between items-center">
    <!-- Header title -->
    <h2 class="text-xl font-bold tracking-tight">Insights Articles</h2>
    <!-- Button create article -->
    <button onclick="openArticleModal()" class="
      flex items-center gap-2 px-5 py-2.5
      bg-[#8EF0DD] shadow-sm
      hover:bg-[#8EF0DD]/90 transition transform active:scale-95 
      text-[#154D41] font-bold text-sm
      rounded-xl1
      ">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Create Article
    </button>
  </div>

  <!-- Table articles -->
  <div class="
  bg-neutral-900 border border-white/10 shadow-xl
  rounded-2xl 
  overflow-hidden
  ">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="
          border-b border-white/10 bg-black/20 
          text-white/50 text-xs font-semibold uppercase tracking-wider
          ">
            <th class="p-4">Featured Image</th>
            <th class="p-4">Title</th>
            <th class="p-4">Category</th>
            <th class="p-4">Status</th>
            <th class="p-4">Views</th>
            <th class="p-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody id="articles-table-body" class="divide-y divide-white/5 text-sm">
          <tr>
            <td colspan="6" class="p-8 text-center text-white/40">Loading articles...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Article Add/Edit Section -->
<div id="article-modal" class="
  fixed inset-0 z-50 flex p-4 
  items-center justify-center 
  bg-[#010C13]/80 backdrop-blur-sm 
  hidden 
  transition-all duration-300">
  <!-- Container box -->
  <div class="
    bg-neutral-900 border border-white/10 shadow-2xl 
    rounded-3xl w-full max-w-3xl max-h-[90vh]
    relative overflow-y-auto 
    transform scale-95 opacity-0 transition-all duration-300
    ">
    <!-- Header edit -->
    <div class="
    border-b border-white/10 
    flex justify-between items-center p-6
    ">
      <h3 id="article-modal-title" class="text-xl font-bold">Write New Article</h3>
      <!-- Close button -->
      <button onclick="closeArticleModal()" class="text-white/40 hover:text-white transition">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Form edit -->
    <form id="article-form" onsubmit="submitArticleForm(event)" class="p-6 space-y-6">
      <input type="hidden" id="article-id">

      <!-- Form title -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="art-title" class="
          block mb-2
          text-xs font-semibold text-white/50 uppercase tracking-wider
          ">
            Article Title
          </label>
          <input type="text" id="art-title" required class="
            w-full rounded-xl px-4 py-3 
            bg-black/40 border border-white/10
            text-white 
            focus:outline-none focus:border-[#8EF0DD] transition-all
            " placeholder="e.g. Demystifying Neural Networks">
        </div>

        <!-- Form description -->
        <div>
          <label for="art-category" class="
            block mb-2
            text-xs font-semibold text-white/50 uppercase tracking-wider
            ">
            Category
          </label>
          <select id="art-category"
            class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[#8EF0DD] transition-all">
            <option value="Machine Learning" class="bg-neutral-900">Machine Learning</option>
            <option value="Data Mining" class="bg-neutral-900">Data Mining</option>
            <option value="Data Science" class="bg-neutral-900">Data Science</option>
            <option value="Web Development" class="bg-neutral-900">Web Development</option>
            <option value="Technology" class="bg-neutral-900">Technology</option>
            <option value="Other" class="bg-neutral-900" selected>Other</option>
          </select>
        </div>
      </div>

      <!-- Article texts -->
      <div>
        <label for="art-content" class="
          block mb-2
          text-xs font-semibold text-white/50 uppercase tracking-wider
          ">
          Content (Supports HTML/Markdown)
        </label>
        <textarea id="art-content" required rows="10" class="
          w-full rounded-xl px-4 py-3
          bg-black/40 border border-white/10 
          text-white font-mono text-sm
          focus:outline-none focus:border-[#8EF0DD] transition-all
          " placeholder="Write your full article here..."></textarea>
      </div>

      <!-- Author and tags -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Form author -->
        <div>
          <label for="art-author" class="
            block mb-2
            text-xs font-semibold text-white/50 uppercase tracking-wider
            ">
            Author
          </label>
          <input type="text" id="art-author" class="
            w-full rounded-xl px-4 py-3
            bg-black/40 border border-white/10 
            text-white 
            focus:outline-none focus:border-[#8EF0DD] transition-all
            " placeholder="Research Team">
        </div>
        <!-- Form tags -->
        <div>
          <label for="art-tags" class="block text-xs font-semibold text-white/50 uppercase tracking-wider mb-2">Tags
            (comma-separated)</label>
          <input type="text" id="art-tags" class="
            w-full rounded-xl px-4 py-3
            bg-black/40 border border-white/10 
            text-white 
            focus:outline-none focus:border-[#8EF0DD] transition-all
            " placeholder="AI, Big Data, Technology, etc">
        </div>
      </div>

      <!-- Featured Image -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Image url -->
        <div>
          <label for="art-image-url" class="
            block mb-2
            text-xs font-semibold text-white/50 uppercase tracking-wider 
            ">
            Featured Image URL
          </label>
          <input type="text" id="art-image-url" class="
            w-full rounded-xl px-4 py-3
            bg-black/40 border border-white/10 
            text-white 
            focus:outline-none focus:border-[#8EF0DD] transition-all
            " placeholder="https://example.com/featured.jpg">
        </div>
        <!-- Image upload -->
        <div>
          <label for="art-image-file" class="
            block mb-2
            text-xs font-semibold text-white/50 uppercase tracking-wider
            ">
            Upload Featured Image
          </label>
          <div id="art-image-dropzone" class="
            border-2 border-dashed border-white/10 
            rounded-xl p-3 
            text-center 
            cursor-pointer hover:border-[#8EF0DD] transition-all
            " onclick="triggerFileInput('art-image-file')">
            <span class="
            text-xs text-white/40 hover:text-white
            " id="art-image-status">
              Drag file here or click to browse
            </span>
            <input type="file" id="art-image-file" accept="image/*" class="hidden"
              onchange="handleFileUpload(this, 'art-image-url', 'art-image-status', 'article')">
          </div>
        </div>
      </div>

      <!-- SEO & Visualization Metadata -->
      <div class="border-t border-white/10 pt-4">
        <h4 class="text-sm font-bold mb-4 text-[#8EF0DD]">SEO & Visualization Metadata</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          <!-- Excerpt/short summary -->
          <div>
            <label for="art-excerpt" class="
              block mb-2
              text-xs font-semibold text-white/50 uppercase tracking-wider
              ">
              Excerpt (Short Summary)
            </label>
            <textarea id="art-excerpt" rows="2" class="
              w-full rounded-xl px-4 py-3
              bg-black/40 border border-white/10 
              text-white 
              focus:outline-none focus:border-[#8EF0DD] transition-all
              " placeholder="Brief intro to entice readers...">
            </textarea>
          </div>
          <!-- SEO meta description -->
          <div>
            <label for="art-seo-desc" class="
              block mb-2
              text-xs font-semibold text-white/50 uppercase tracking-wider
              ">
              SEO Meta Description
            </label>
            <textarea id="art-seo-desc" rows="2" class="
              w-full rounded-xl px-4 py-3
              bg-black/40 border border-white/10 
              text-white 
              focus:outline-none focus:border-[#8EF0DD] transition-all
              " placeholder="Description for search engines...">
            </textarea>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- SEO keywords -->
          <div>
            <label for="art-seo-keywords" class="
              block mb-2
              text-xs font-semibold text-white/50 uppercase tracking-wider
              ">
              SEO Keywords (comma-separated)
            </label>
            <input type="text" id="art-seo-keywords" class="
              w-full rounded-xl px-4 py-3
              bg-black/40 border border-white/10 
              text-white 
              focus:outline-none focus:border-[#8EF0DD] transition-all
              " placeholder="neural networks, data science, tutorial">
          </div>
          <!-- Tableau visualization url -->
          <div>
            <label for="art-tableau-url" class="
              block mb-2
              text-xs font-semibold text-white/50 uppercase tracking-wider
              ">
              Tableau Visualization URL
            </label>
            <input type="text" id="art-tableau-url" class="
              w-full rounded-xl px-4 py-3
              bg-black/40 border border-white/10 
              text-white 
              focus:outline-none focus:border-[#8EF0DD] transition-all
              " placeholder="https://public.tableau.com/views/...">
          </div>
        </div>
      </div>

      <!-- Save and cancel buttons -->
      <div class="flex justify-end gap-3 border-t border-white/10 pt-4">
        <!-- Cancel button -->
        <button type="button" onclick="closeArticleModal()" class="
          px-5 py-2.5 
          border border-white/10 hover:bg-white/5 rounded-xl 
          font-medium text-sm transition
          ">
          Cancel
        </button>
        <!-- Save button -->
        <button type="submit" class="
          px-5 py-2.5 bg-[#8EF0DD] hover:bg-[#8EF0DD]/90 
          text-[#154D41] font-bold rounded-xl text-sm transition">
          Save Article
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // ARTICLES LOGIC (CRUD)

  // Get articles on db
  function fetchArticles() {
    const tbody = document.getElementById('articles-table-body');
    if (!tbody) return;
    tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-white/40">Loading articles...</td></tr>';

    // Call the ADMIN endpoint to get both drafts and published articles
    fetch('/api/insights-admin/all?limit=100', {
      method: 'GET',
      headers: {
        'Authorization': `Bearer ${adminToken}`
      }
    })
      .then(res => {
        if (!res.ok) {
          if (res.status === 403 || res.status === 401) {
            logout();
            throw new Error('Access token invalid or expired.');
          }
          return res.json().then(data => { throw new Error(data.error || 'Failed to load articles') });
        }
        return res.json();
      })
      .then(data => {
        if (!data.success) throw new Error(data.error || 'Failed to fetch articles');

        const articles = data.data || [];
        if (articles.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-white/40">No articles found. Click "Create Article" to write one.</td></tr>';
          return;
        }

        tbody.innerHTML = articles.map(art => {
          const cover = art.featured_image || '/image-assets/dataset-cover/default-cover.jpg';
          const isPublished = art.status === 'published';

          const badgeClass = isPublished
            ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'
            : 'bg-amber-500/10 text-amber-400 border-amber-500/20';
          const badgeText = isPublished ? 'Published' : 'Draft';

          const publishActionBtn = isPublished
            ? `<button onclick="togglePublish('${art.id}', false)" title="Unpublish (make Draft)" class="p-2 border border-white/10 hover:border-amber-500/50 hover:bg-amber-500/10 text-white/70 hover:text-white rounded-lg transition">
                 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path></svg>
               </button>`
            : `<button onclick="togglePublish('${art.id}', true)" title="Publish" class="p-2 border border-white/10 hover:border-emerald-500/50 hover:bg-emerald-500/10 text-white/70 hover:text-white rounded-lg transition">
                 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
               </button>`;

          return `
            <tr class="hover:bg-white/5 transition-colors">
              <td class="p-4">
                <img src="${cover}" class="w-12 h-12 object-cover rounded-lg border border-white/10" alt="Cover">
              </td>
              <td class="p-4 font-bold text-white/90">${escapeHtml(art.title)}</td>
              <td class="p-4 text-white/60">${escapeHtml(art.category || 'Other')}</td>
              <td class="p-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold border ${badgeClass}">
                  ${badgeText}
                </span>
              </td>
              <td class="p-4 text-white/60 font-mono">${art.views || 0}</td>
              <td class="p-4 text-right">
                <div class="flex justify-end gap-2">
                  ${publishActionBtn}
                  <button onclick="editArticle('${art.id}')" class="p-2 border border-white/10 hover:border-[#8EF0DD]/50 hover:bg-[#8EF0DD]/10 text-white/70 hover:text-white rounded-lg transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                  </button>
                  <button onclick="deleteArticle('${art.id}', '${escapeQuote(art.title)}')" class="p-2 border border-white/10 hover:border-red-500/50 hover:bg-red-500/10 text-white/70 hover:text-white rounded-lg transition">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      })
      .catch(err => {
        console.error(err);
        tbody.innerHTML = `<tr><td colspan="6" class="p-8 text-center text-red-400 font-medium">${err.message}</td></tr>`;
      });
  }

  // Open edit section 
  function openArticleModal() {
    const form = document.getElementById('article-form');
    if (form) form.reset();
    document.getElementById('article-id').value = '';
    document.getElementById('article-modal-title').innerText = 'Write New Article';

    // Clear file status
    const artImageStatus = document.getElementById('art-image-status');
    if (artImageStatus) {
      artImageStatus.innerText = 'Drag file here or click to browse';
      artImageStatus.className = 'text-xs text-white/40';
    }

    const modal = document.getElementById('article-modal');
    if (modal) {
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.firstElementChild.classList.remove('scale-95', 'opacity-0');
        modal.firstElementChild.classList.add('scale-100', 'opacity-100');
      }, 50);
    }
  }

  // Close edit section 
  function closeArticleModal() {
    const modal = document.getElementById('article-modal');
    if (!modal) return;

    modal.firstElementChild.classList.remove('scale-100', 'opacity-100');
    modal.firstElementChild.classList.add('scale-95', 'opacity-0');
    setTimeout(() => modal.classList.add('hidden'), 300);
  }

  // Helper edit article store value
  function editArticle(id) {
    fetch('/api/insights-admin/all?limit=100', {
      headers: { 'Authorization': `Bearer ${adminToken}` }
    })
      .then(res => res.json())
      .then(data => {
        const articles = data.data || [];
        const art = articles.find(a => a.id === id);
        if (!art) {
          if (typeof showToast === 'function') {
            showToast('Article not found.', 'error');
          }
          return;
        }

        openArticleModal();
        document.getElementById('article-modal-title').innerText = 'Edit Article';
        document.getElementById('article-id').value = art.id;
        document.getElementById('art-title').value = art.title;
        document.getElementById('art-category').value = art.category || 'Other';
        document.getElementById('art-content').value = art.content;
        document.getElementById('art-author').value = art.author || 'NITE Team';
        document.getElementById('art-tags').value = (art.tags || []).join(', ');
        document.getElementById('art-image-url').value = art.featured_image || '';
        document.getElementById('art-excerpt').value = art.excerpt || '';
        document.getElementById('art-seo-desc').value = art.seo_meta_description || '';
        document.getElementById('art-seo-keywords').value = (art.seo_keywords || []).join(', ');
        document.getElementById('art-tableau-url').value = art.tableau_url || '';
      });
  }

  // Submit article form
  function submitArticleForm(event) {
    event.preventDefault();

    const id = document.getElementById('article-id').value;
    const title = document.getElementById('art-title').value.trim();
    const category = document.getElementById('art-category').value;
    const content = document.getElementById('art-content').value.trim();
    const author = document.getElementById('art-author').value.trim();
    const tags = document.getElementById('art-tags').value.split(',').map(t => t.trim()).filter(Boolean);
    const featuredImage = document.getElementById('art-image-url').value.trim();
    const excerpt = document.getElementById('art-excerpt').value.trim();
    const seoMetaDescription = document.getElementById('art-seo-desc').value.trim();
    const seoKeywords = document.getElementById('art-seo-keywords').value.split(',').map(t => t.trim()).filter(Boolean);
    const tableauUrl = document.getElementById('art-tableau-url').value.trim();

    const payload = {
      title,
      category,
      content,
      author,
      tags,
      featuredImage,
      excerpt,
      seoMetaDescription,
      seoKeywords,
      tableauUrl
    };
    // Check if status is editing article or add new
    const isEdit = !!id;
    const url = isEdit ? `/api/insights/${id}` : '/api/insights';
    const method = isEdit ? 'PUT' : 'POST';

    // Fetch post or put article api
    fetch(url, {
      method: method,
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${adminToken}`
      },
      body: JSON.stringify(payload)
    })
      .then(res => {
        if (!res.ok) {
          if (res.status === 403 || res.status === 401) {
            logout();
            throw new Error('Access token expired. Re-authenticate.');
          }
          return res.json().then(data => { throw new Error(data.error || 'Failed to save article') });
        }
        return res.json();
      })
      .then(data => {
        if (typeof showToast === 'function') {
          showToast(isEdit ? 'Article updated successfully!' : 'Article drafted successfully!', 'success');
        }
        closeArticleModal();
        fetchArticles();
      })
      .catch(err => {
        console.error(err);
        if (typeof showToast === 'function') {
          showToast(err.message, 'error');
        }
      });
  }

  // Toggle publish or unpublish article
  function togglePublish(id, shouldPublish) {
    const endpoint = shouldPublish ? 'publish' : 'unpublish';

    fetch(`/api/insights/${id}/${endpoint}`, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${adminToken}`
      }
    })
      .then(res => {
        if (!res.ok) {
          if (res.status === 403 || res.status === 401) {
            logout();
            throw new Error('Access token expired. Re-authenticate.');
          }
          return res.json().then(data => { throw new Error(data.error || 'Failed to change publish state') });
        }
        return res.json();
      })
      .then(data => {
        if (typeof showToast === 'function') {
          showToast(shouldPublish ? 'Article published and live!' : 'Article returned to drafts.', 'success');
        }
        fetchArticles();
      })
      .catch(err => {
        console.error(err);
        if (typeof showToast === 'function') {
          showToast(err.message, 'error');
        }
      });
  }

  // Delete article
  function deleteArticle(id, title) {
    if (!confirm(`Are you absolutely sure you want to delete article: "${title}"?`)) return;

    fetch(`/api/insights/${id}`, {
      method: 'DELETE',
      headers: {
        'Authorization': `Bearer ${adminToken}`
      }
    })
      .then(res => {
        if (!res.ok) {
          if (res.status === 403 || res.status === 401) {
            logout();
            throw new Error('Access token expired. Re-authenticate.');
          }
          return res.json().then(data => { throw new Error(data.error || 'Failed to delete article') });
        }
        return res.json();
      })
      .then(data => {
        if (typeof showToast === 'function') {
          showToast('Article deleted successfully.', 'success');
        }
        fetchArticles();
      })
      .catch(err => {
        console.error(err);
        if (typeof showToast === 'function') {
          showToast(err.message, 'error');
        }
      });
  }
</script>