<!-- Lock Screen Overlay -->

<!-- Background blur -->
<div id="lock-screen" class="
  fixed inset-0 z-40 mt-20
  bg-[#010C13]/90 backdrop-blur-md 
  flex items-center justify-center 
  transition-all duration-300 
  hidden
  ">

  <!-- Lock box -->
  <div class="
    bg-neutral-900/80 border border-white/10 shadow-2xl
    p-8 mx-4
    rounded-3xl max-w-md w-full backdrop-blur-xl 
    relative overflow-hidden group
    ">

    <!-- Header -->
    <div class="text-center mb-6">
      <!-- Lock icon -->
      <div class="
      inline-flex rounded-2xl p-3 mb-4 
      bg-white/5 border border-white/10 
      text-[#8EF0DD]
      ">
        <i data-lucide="lock-keyhole" class="text-light-teal"></i>
      </div>
      <!-- Subtitle text -->
      <h2 class="text-2xl font-extrabold tracking-tight">Not Into Tech Admin</h2>
      <p class="text-white/60 text-sm mt-2">Please enter your admin token to gain access</p>
    </div>

    <!-- Login form -->
    <form id="auth-form" onsubmit="handleAuth(event)">
      <div class="space-y-4">

        <div>
          <!-- Input token text -->
          <label for="admin-token" class="
            block mb-2
            text-xs font-semibold uppercase tracking-wider text-white/50 
            ">
            Access Token
          </label>
          <div class="relative">
            <!-- Token input zone -->
            <input type="password" id="admin-token" required class="
              w-full rounded-xl px-4 py-3
              bg-black/40 border border-white/10
              text-white placeholder-white/30 
              focus:outline-none focus:border-[#8EF0DD] focus:ring-1 focus:ring-[#8EF0DD] transition-all
              " placeholder="Enter Token">
            <!-- Token visibility button -->
            <button type="button" onclick="toggleTokenVisibility()" class="
              absolute inset-y-0 right-0 pr-3 
              flex items-center 
              text-white/40 
              transition hover:text-white
              ">
              <i data-lucide="eye" id="eye-icon"></i>
            </button>
          </div>
        </div>

        <!-- Submit token button -->
        <button type="submit" class="
          w-full rounded-xl py-3 
          bg-[#8EF0DD] shadow-md
          text-[#154D41] font-bold 
          transition duration-300 transform
          hover:bg-[#8EF0DD]/90 active:scale-95
          ">
          Unlock Dashboard
        </button>

      </div>
    </form>

  </div>
</div>

<%- include('../scripts/script-lockscreen') %>