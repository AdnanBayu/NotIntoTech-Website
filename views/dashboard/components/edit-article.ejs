<div id="article-modal" class="
  fixed inset-0 z-50 flex p-4 
  items-center justify-center 
  bg-[#010C13]/80 backdrop-blur-sm 
  hidden 
  transition-all duration-300">
    <!-- Container box -->
    <div class="
    bg-neutral-900 border border-white/10 shadow-2xl 
    rounded-3xl w-full max-w-3xl max-h-[90vh]
    relative overflow-y-auto 
    transform scale-95 opacity-0 transition-all duration-300
    ">
        <!-- Header edit -->
        <div class="
            border-b border-white/10 
            flex justify-between items-center p-6
        ">
            <h3 id="article-modal-title" class="text-xl font-bold">Write New Article</h3>
            <!-- Close button -->
            <button onclick="closeArticleModal()" class="text-white/40 hover:text-white transition">
                <i data-lucide="x"></i>
            </button>
        </div>

        <!-- Form edit -->
        <form id="article-form" onsubmit="submitArticleForm(event)" class="p-6 space-y-6">
            <input type="hidden" id="article-id">

            <!-- Form title -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label for="art-title" class="
                        block mb-2
                        text-xs font-semibold text-white/50 uppercase tracking-wider
                    ">
                        Article Title
                    </label>
                    <input type="text" id="art-title" required class="
                        w-full rounded-xl px-4 py-3 
                        bg-black/40 border border-white/10
                        text-white 
                        focus:outline-none focus:border-[#8EF0DD] transition-all
                    " placeholder="e.g. Demystifying Neural Networks">
                </div>

                <!-- Form description -->
                <div>
                    <label for="art-category" class="
                        block mb-2
                        text-xs font-semibold text-white/50 uppercase tracking-wider
                    ">
                        Category
                    </label>
                    <select id="art-category"
                        class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-[#8EF0DD] transition-all">
                        <option value="other" class="bg-neutral-900" selected>Loading categories...</option>
                    </select>
                </div>
            </div>

            <!-- Article texts -->
            <div>
                <label for="art-content" class="
                    block mb-2
                    text-xs font-semibold text-white/50 uppercase tracking-wider
                ">
                    Content (Supports HTML/Markdown)
                </label>
                <textarea id="art-content" required rows="10" class="
                    w-full rounded-xl px-4 py-3
                    bg-black/40 border border-white/10 
                    text-white font-mono text-sm
                    focus:outline-none focus:border-[#8EF0DD] transition-all
                " placeholder="Write your full article here..."></textarea>
            </div>

            <!-- Author and tags -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Form author -->
                <div>
                    <label for="art-author" class="
                        block mb-2
                        text-xs font-semibold text-white/50 uppercase tracking-wider
                    ">
                        Author
                    </label>
                    <input type="text" id="art-author" class="
                        w-full rounded-xl px-4 py-3
                        bg-black/40 border border-white/10 
                        text-white 
                        focus:outline-none focus:border-[#8EF0DD] transition-all
                    " placeholder="Research Team">
                </div>
                <!-- Form tags -->
                <div>
                    <label for="art-tags"
                        class="block text-xs font-semibold text-white/50 uppercase tracking-wider mb-2">
                        Tags (comma-separated)
                    </label>
                    <input type="text" id="art-tags" class="
                        w-full rounded-xl px-4 py-3
                        bg-black/40 border border-white/10 
                        text-white 
                        focus:outline-none focus:border-[#8EF0DD] transition-all
                    " placeholder="AI, Big Data, Technology, etc">
                </div>
            </div>

            <!-- Featured Image -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Image url -->
                <div>
                    <label for="art-image-url" class="
                        block mb-2
                        text-xs font-semibold text-white/50 uppercase tracking-wider 
                    ">
                        Featured Image URL
                    </label>
                    <input type="text" id="art-image-url" class="
                        w-full rounded-xl px-4 py-3
                        bg-black/40 border border-white/10 
                        text-white 
                        focus:outline-none focus:border-[#8EF0DD] transition-all
                    " placeholder="https://example.com/featured.jpg">
                </div>
                <!-- Image upload -->
                <div>
                    <label for="art-image-file" class="
                        block mb-2
                        text-xs font-semibold text-white/50 uppercase tracking-wider
                    ">
                        Upload Featured Image
                    </label>
                    <div id="art-image-dropzone" class="
                        border-2 border-dashed border-white/10 
                        rounded-xl p-3 
                        text-center 
                        cursor-pointer hover:border-[#8EF0DD] transition-all
                    " onclick="triggerFileInput('art-image-file')">
                        <span class="
                            text-xs text-white/40 hover:text-white
                        " id="art-image-status">
                            Drag file here or click to browse
                        </span>
                        <input type="file" id="art-image-file" accept="image/*" class="hidden"
                            onchange="handleFileUpload(this, 'art-image-url', 'art-image-status', 'article')">
                    </div>
                </div>
            </div>

            <!-- SEO & Visualization Metadata -->
            <div class="border-t border-white/10 pt-4">
                <h4 class="text-sm font-bold mb-4 text-[#8EF0DD]">SEO & Visualization Metadata</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <!-- Excerpt/short summary -->
                    <div>
                        <label for="art-excerpt" class="
                            block mb-2
                            text-xs font-semibold text-white/50 uppercase tracking-wider
                        ">
                            Excerpt (Short Summary)
                        </label>
                        <textarea id="art-excerpt" rows="2" class="
                            w-full rounded-xl px-4 py-3
                            bg-black/40 border border-white/10 
                            text-white 
                            focus:outline-none focus:border-[#8EF0DD] transition-all
                        " placeholder="Brief intro to entice readers...">
                        </textarea>
                    </div>
                    <!-- SEO meta description -->
                    <div>
                        <label for="art-seo-desc" class="
                            block mb-2
                            text-xs font-semibold text-white/50 uppercase tracking-wider
                        ">
                            SEO Meta Description
                        </label>
                        <textarea id="art-seo-desc" rows="2" class="
                            w-full rounded-xl px-4 py-3
                            bg-black/40 border border-white/10 
                            text-white 
                            focus:outline-none focus:border-[#8EF0DD] transition-all
                        " placeholder="Description for search engines...">
                        </textarea>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- SEO keywords -->
                    <div>
                        <label for="art-seo-keywords" class="
                            block mb-2
                            text-xs font-semibold text-white/50 uppercase tracking-wider
                        ">
                            SEO Keywords (comma-separated)
                        </label>
                        <input type="text" id="art-seo-keywords" class="
                            w-full rounded-xl px-4 py-3
                            bg-black/40 border border-white/10 
                            text-white 
                            focus:outline-none focus:border-[#8EF0DD] transition-all
                        " placeholder="neural networks, data science, tutorial">
                    </div>
                    <!-- Tableau visualization url -->
                    <div>
                        <label for="art-tableau-url" class="
                            block mb-2
                            text-xs font-semibold text-white/50 uppercase tracking-wider
                        ">
                            Tableau Visualization URL
                        </label>
                        <input type="text" id="art-tableau-url" class="
                            w-full rounded-xl px-4 py-3
                            bg-black/40 border border-white/10 
                            text-white 
                            focus:outline-none focus:border-[#8EF0DD] transition-all
                        " placeholder="https://public.tableau.com/views/...">
                    </div>
                </div>
            </div>

            <!-- Save and cancel buttons -->
            <div class="flex justify-end gap-3 border-t border-white/10 pt-4">
                <!-- Cancel button -->
                <button type="button" onclick="closeArticleModal()" class="
                    px-5 py-2.5 
                    border border-white/10 hover:bg-white/5 rounded-xl 
                    font-medium text-sm transition
                ">
                    Cancel
                </button>
                <!-- Save button -->
                <button type="submit" class="
                    px-5 py-2.5 bg-[#8EF0DD] hover:bg-[#8EF0DD]/90 
                    text-[#154D41] font-bold rounded-xl text-sm transition">
                    Save Article
                </button>
            </div>
        </form>
    </div>
</div>