<!-- Full-page chat panel, sits below the site header -->
<div id="chat-panel" class="
    fixed 
    top-[70px] left-0 right-0 bottom-0
    flex flex-col
">

    <%- include('./chat-window') %>

    <%- include('./input-zone') %>

</div>

<style>
    .typing-dot {
        width: 6px;
        height: 6px;
        background-color: #154D41;
        border-radius: 50%;
        display: inline-block;
        animation: typingBounce 1.2s infinite ease-in-out;
    }
    .typing-dot:nth-child(1) { animation-delay: 0s; }
    .typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .typing-dot:nth-child(3) { animation-delay: 0.4s; }

    @keyframes typingBounce {
        0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
        30%            { transform: translateY(-5px); opacity: 1; }
    }

    #chat-input:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    #chat-form button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        pointer-events: none;
    }
</style>

<script>
    const CHATBOT_ENDPOINT = '/api/chat';

    document.addEventListener("DOMContentLoaded", () => {
        let sessionId = sessionStorage.getItem('chatSessionId');
        if (!sessionId) {
            sessionId = crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2, 15);
            sessionStorage.setItem('chatSessionId', sessionId);
        }

        const chatForm = document.getElementById('chat-form');
        const chatInput = document.getElementById('chat-input');
        const chatWindow = document.getElementById('chat-window');

        const welcomePanel = document.getElementById('welcome-panel');
        const messageContainer = document.getElementById('message-container');

        if (!chatForm) return;

        // Dismiss the welcome panel dynamically on first interaction
        function dismissWelcomePanel() {
            if (welcomePanel && !welcomePanel.classList.contains('hidden')) {
                // Fade out & scale out transition
                welcomePanel.classList.remove('opacity-100', 'scale-100');
                welcomePanel.classList.add('opacity-0', 'scale-95');
                
                setTimeout(() => {
                    welcomePanel.classList.add('hidden');
                    // Show the container holding normal stream of messages
                    messageContainer.classList.remove('hidden');
                    messageContainer.classList.add('flex');
                    // Adjust parent alignment if needed
                    chatWindow.classList.remove('justify-center');
                }, 400); // matches the duration-500/duration-400 window
            }
        }

        // Setup click listeners for Prompt suggestion buttons
        document.querySelectorAll('.prompt-suggestion').forEach(button => {
            button.addEventListener('click', () => {
                const subtext = button.querySelector('span:last-child').textContent;
                chatInput.value = subtext;
                chatInput.focus();
                
                // Optional: Auto-submit suggestion on click
                chatForm.dispatchEvent(new Event('submit'));
            });
        });

        // Handle chatbot response raw format
        function parseMarkdown(text) {
            return text
                // Escape raw HTML to prevent XSS
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                // Bold: **text** or __text__
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/__(.+?)__/g, '<strong>$1</strong>')
                // Italic: *text* or _text_
                .replace(/\*(.+?)\*/g, '<em>$1</em>')
                .replace(/_(.+?)_/g, '<em>$1</em>')
                // Inline code: `code`
                .replace(/`([^`]+)`/g, '<code class="bg-slate-100 text-[#154D41] px-1 rounded text-[0.85em]">$1</code>')
                // Line breaks
                .replace(/\n/g, '<br>');
        }

        // Add message user & chatbot to UI
        function addMessage(text, isUser = false) {
            // Guarantee welcomer is cleared before writing chat streams
            dismissWelcomePanel();
            
            const msgDiv = document.createElement('div');
            msgDiv.className = isUser
                ? "ml-auto bg-deep-dark-blue/80 p-4 rounded-lg self-end text-white border-r-4 border-light-blue max-w-[80%]"
                : "bg-dark-teal/10 p-4 rounded-lg self-start text-black border-l-4 border-dark-teal max-w-[80%]";
            if (isUser) {
                msgDiv.textContent = text;
            } else {
                msgDiv.innerHTML = parseMarkdown(text);
            }
            chatWindow.appendChild(msgDiv);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        // Show typing as chatbot process response
        function showTypingIndicator() {
            const indicator = document.createElement('div');
            indicator.id = 'typing-indicator';
            indicator.className = "bg-dark-teal/10 p-4 rounded-lg self-start text-black border-l-2 border-dark-teal max-w-[80%] flex items-center gap-1";
            indicator.innerHTML = `
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
            `;
            chatWindow.appendChild(indicator);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        // Remove typing indicator loading
        function removeTypingIndicator() {
            const indicator = document.getElementById('typing-indicator');
            if (indicator) indicator.remove();
        }

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = chatInput.value.trim();
            if (!text) return;

            addMessage(text, true);
            chatInput.value = '';
            chatInput.disabled = true;
            chatForm.querySelector('button').disabled = true;

            showTypingIndicator();

            try {
                const response = await fetch(CHATBOT_ENDPOINT, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text, sessionId: sessionId })
                });

                const data = await response.json();
                const botResponse = data.output;

                removeTypingIndicator();
                addMessage(botResponse);

            } catch (error) {
                removeTypingIndicator();
                addMessage("The NITE chatbot is temporarily unreachable. Please check server logs.");
            } finally {
                chatInput.disabled = false;
                chatForm.querySelector('button').disabled = false;
                chatInput.focus();
            }
        });
    });
</script>
