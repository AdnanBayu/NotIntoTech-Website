<!DOCTYPE html>
<html lang="en">
<%- include('../components/head', { text: 'Insights' }) %>

    <body class="bg-[#154D41]">

        <!-- Content Wrapper -->
        <div class="relative z-20">

            <!-- Header Website -->
            <section class="p-[0.5em]">
                <%- include('../components/header') %>
            </section>

            <!-- Main Content -->
            <section>
                <main class="px-4 py-16 flex justify-center">
                    <article class="w-full max-w-7xl">

                        <!-- Article Header -->
                        <div class="mb-8">
                            <!-- Category -->
                            <div class="mb-4">
                                <span
                                    class="inline-block bg-[#8EF0DD] text-[#154D41] text-xs font-semibold px-3 py-1 rounded-full">
                                    <%= article.category || 'Article' %>
                                </span>
                            </div>

                            <!-- Title -->
                            <h1 class="text-white text-4xl lg:text-5xl font-bold mb-6 leading-tight">
                                <%= article.title %>
                            </h1>

                            <!-- Meta Info -->
                            <div
                                class="flex flex-wrap gap-4 text-gray-400 text-sm pb-6 border-b border-white border-opacity-10">
                                <span>By <strong class="text-white">
                                        <%= article.author || 'NITE Team' %>
                                    </strong></span>
                                <span>
                                    <%= article.updated_at || 'Unknown' %>
                                </span>
                                <span id="viewCount">
                                    <%= article.views || 0 %> views
                                </span>
                            </div>
                        </div>

                        <!-- Article Content -->
                        <div class="prose prose-invert max-w-none mb-12">
                            <div class="text-white leading-relaxed text-base lg:text-lg">
                                <%- article.content %>
                            </div>
                        </div>

                        <!-- Tableau Dashboard Section -->
                        <%- include('components/tableau-section', { article }) %>

                            <!-- Tags Section -->
                            <%- include('components/tag-section', { article }) %>

                    </article>
                </main>
            </section>

            <!-- Footer Website -->
            <section>
                <%- include('../components/footer') %>
            </section>

        </div>

        <script src="/script.js"></script>

    </body>

</html>