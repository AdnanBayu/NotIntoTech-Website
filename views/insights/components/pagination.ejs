<!-- Pagination -->
<% if (pagination && pagination.pages> 1) { %>
    <div class="flex justify-center gap-2 mb-12">
        <% for (let i=1; i <=pagination.pages; i++) { %>
            <% if (i===pagination.page) { %>
                <button class="
                    rounded-lg 
                    bg-light-teal
                    text-dark-purple 
                    font-semibold 
                    px-4 
                    py-2
                ">
                    <%= i %>
                </button>
                <% } else { %>
                    <a href="/insights?page=<%= i %>" class="
                            rounded-lg 
                            bg-white/40 
                            text-white 
                            hover:bg-opacity-20 
                            transition-all 
                            px-4 
                            py-2
                        ">
                        <%= i %>
                    </a>
                    <% } %>
                        <% } %>
    </div>
    <% } %>