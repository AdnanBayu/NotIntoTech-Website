<% if (article.tableauUrl) { %>
    <section class="my-16 
        border-t border-white border-opacity-10 
        pt-12
    ">
        <h2 class="text-white text-3xl font-bold mb-8">
            Data Visualization
        </h2>

        <div class="
                mb-12 p-4
                bg-deep-dark-blue
                bg-opacity-5 backdrop-blur-sm 
                rounded-lg 
                border border-white border-opacity-10
            ">
            <!-- Tableau Embed -->
            <div class="
                bg-black bg-opacity-30 
                rounded-lg 
                overflow-hidden 
                min-h-[600px]
            ">
                <tableau-viz id="tableau-dashboard" data-src="<%= article.tableauUrl %>" width="100%" height="600"
                    style="display: block;">
                </tableau-viz>
            </div>
        </div>

    </section>
    <% } %>