<!DOCTYPE html>
<html lang="en">
<%- include('../components/head', { text: 'Insights' }) %>

    <body class="bg-[#154D41]">

        <!-- Content Wrapper -->
        <div class="relative z-20">

            <!-- Header Website -->
            <section>
                <%- include('../components/header') %>
            </section>

            <!-- Main Content -->
            <section>
                <main>
                    <!-- Welcome Text -->
                    <header class="max-w-6xl mx-auto mt-25 mb-12 px-10">
                        <div class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
                            <div>
                                <h1 class="text-[2em] md:text-[3em] font-extrabold text-white tracking-tight">
                                    The Knowledge Base
                                </h1>
                                <p class="max-w-2xl text-white/80 mt-3 text-[0.9em]">
                                    Dive into our collection of data-driven articles, deep dives, and technical
                                    explorations. From casual insights to strategic thinking - data that works for
                                    you.
                                </p>
                            </div>
                            <div class="flex flex-col gap-2 border-l border-white/10 pl-8">
                                <p class="text-[0.9em] md:text-[1em] uppercase tracking-widest text-white font-bold">
                                    Total Articles
                                </p>
                                <p class="text-[1em] md:text-[2em] font-bold text-white">
                                    <%= articles.length %>
                                </p>
                            </div>
                        </div>
                    </header>

                    <!-- Main Content -->

                    <!-- Featured Article -->
                    <% if (articles && articles.length> 0) { %>
                        <%- include('components/featured-article', { articles: articles }) %>
                            <% } %>

                                <!--  Articles Card Grid -->
                                <%- include('components/articles-grid', { articles: articles }) %>

                                    <!-- Pagination -->
                                    <%- include('components/pagination', { pagination: pagination }) %>
                </main>
            </section>

            <!-- Footer Website -->
            <section>
                <%- include('../components/footer') %>
            </section>

        </div>

        <script src="script.js"></script>
        <script src="https://unpkg.com/lucide@latest"></script>
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                lucide.createIcons();
            });
        </script>

    </body>

</html>