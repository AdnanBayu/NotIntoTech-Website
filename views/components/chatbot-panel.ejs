<div class="
        flex flex-col 
        h-[400px] rounded-2xl 
        bg-white/80 backdrop-blur-xl shadow-2xl 
        overflow-hidden border border-slate-200
    ">

    <!-- Top Header -->
    <div class="
        bg-deep-dark-blue 
        p-4 
        text-white 
        flex items-center justify-between
    ">
        <div class="flex items-center gap-3">
            <div class="w-3 h-3 bg-dark-teal rounded-full animate-pulse"></div> <!-- Pulsing Circle -->
            <span class="font-medium text-[0.8em] tracking-wide">NITE Chatbot</span> <!-- Text -->
        </div>
    </div>

    <!-- Chat Section -->
    <div id="chat-window" class="
        flex-grow overflow-y-auto space-y-4 
        text-[0.9em] 
        bg-white/50 
        scroll-smooth p-6 
    ">
        <div class="
                bg-dark-teal/5 
                text-slate-700 
                rounded-lg rounded-tl-none 
                border-l-2 border-dark-teal 
                max-w-[80%] p-4
            ">
            Welcome! Let our chatbot help you start your technical transformation today.
        </div>
    </div>

    <!-- Input Zone -->
    <form id="chat-form" class="bg-white border-t border-slate-100 flex gap-2 p-4">

        <input id="chat-input" type="text" placeholder="Ask about tech, competition, business..."
            class="flex-grow border border-slate-200 focus:outline-none focus:ring-1 focus:ring-dark-teal px-4 py-2"
            autocomplete="off">

        <button type="submit" class="bg-dark-teal p-3 rounded-xl hover:scale-105 transition-transform active:scale-95">
            <i data-lucide="send" class="text-white font-medium"></i>
        </button>

    </form>

</div>

<style>
    .typing-dot {
        width: 6px;
        height: 6px;
        background-color: #154D41;
        border-radius: 50%;
        display: inline-block;
        animation: typingBounce 1.2s infinite ease-in-out;
    }

    .typing-dot:nth-child(1) {
        animation-delay: 0s;
    }

    .typing-dot:nth-child(2) {
        animation-delay: 0.2s;
    }

    .typing-dot:nth-child(3) {
        animation-delay: 0.4s;
    }

    @keyframes typingBounce {

        0%,
        60%,
        100% {
            transform: translateY(0);
            opacity: 0.4;
        }

        30% {
            transform: translateY(-5px);
            opacity: 1;
        }
    }

    #chat-input:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    #chat-form button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
        pointer-events: none;
    }
</style>

<script>
    const CHATBOT_ENDPOINT = '/api/chat';

    document.addEventListener("DOMContentLoaded", () => {
        let sessionId = sessionStorage.getItem('chatSessionId');
        if (!sessionId) {
            sessionId = crypto.randomUUID ? crypto.randomUUID() : Math.random().toString(36).substring(2, 15);
            sessionStorage.setItem('chatSessionId', sessionId);
        }

        const chatForm = document.getElementById('chat-form');
        const chatInput = document.getElementById('chat-input');
        const chatWindow = document.getElementById('chat-window');

        if (!chatForm) return;

        // Handle chatbot response raw format
        function parseMarkdown(text) {
            return text
                // Escape raw HTML to prevent XSS
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                // Bold: **text** or __text__
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/__(.+?)__/g, '<strong>$1</strong>')
                // Italic: *text* or _text_
                .replace(/\*(.+?)\*/g, '<em>$1</em>')
                .replace(/_(.+?)_/g, '<em>$1</em>')
                // Inline code: `code`
                .replace(/`([^`]+)`/g, '<code class="bg-slate-100 text-[#154D41] px-1 rounded text-[0.85em]">$1</code>')
                // Line breaks
                .replace(/\n/g, '<br>');
        }

        // Add message user & chatbot to UI
        function addMessage(text, isUser = false) {
            const msgDiv = document.createElement('div');
            msgDiv.className = isUser
                ? "bg-deep-dark-blue/80 p-4 rounded-lg self-end text-white border-r-2 border-dark-teal max-w-[80%]"
                : "bg-dark-teal/10 p-4 rounded-lg self-start text-black border-l-2 border-dark-teal max-w-[80%]";
            if (isUser) {
                msgDiv.textContent = text;
            } else {
                msgDiv.innerHTML = parseMarkdown(text);
            }
            chatWindow.appendChild(msgDiv);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        // Show typing as chatbot process response
        function showTypingIndicator() {
            const indicator = document.createElement('div');
            indicator.id = 'typing-indicator';
            indicator.className = "bg-dark-teal/10 p-4 rounded-lg self-start text-black border-l-2 border-dark-teal max-w-[80%] flex items-center gap-1";
            indicator.innerHTML = `
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
                <span class="typing-dot"></span>
            `;
            chatWindow.appendChild(indicator);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }

        // Remove typing indicator loading
        function removeTypingIndicator() {
            const indicator = document.getElementById('typing-indicator');
            if (indicator) indicator.remove();
        }

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = chatInput.value.trim();
            if (!text) return;

            addMessage(text, true);
            chatInput.value = '';
            chatInput.disabled = true;
            chatForm.querySelector('button').disabled = true;

            showTypingIndicator();

            try {
                const response = await fetch(CHATBOT_ENDPOINT, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text, sessionId: sessionId })
                });

                const data = await response.json();
                const botResponse = data.output;

                removeTypingIndicator();
                addMessage(botResponse);

            } catch (error) {
                removeTypingIndicator();
                addMessage("The NITE chatbot is temporarily unreachable. Please check server logs.");
            } finally {
                chatInput.disabled = false;
                chatForm.querySelector('button').disabled = false;
                chatInput.focus();
            }
        });
    });
</script>