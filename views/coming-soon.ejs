<!DOCTYPE html>
<html lang="en">
<%- include('components/head', { text: 'Coming Soon' }) %>

    <body class="bg-[#154D41]">

        <!-- Content Wrapper -->
        <div class="relative z-20">

            <!-- Header Website -->
            <section>
                <%- include('components/header') %>
            </section>

            <!-- Main Content -->
            <section>
                <canvas id="noiseCanvas" class="fixed top-0 left-0 w-full h-full z-0 opacity-40"></canvas>

                <main
                    class="relative z-10 flex flex-col items-center justify-center min-h-screen px-6 py-12 pointer-events-none">
                    <!-- Main Text -->
                    <div class="text-center mt-16 mb-10 md:mt-24 pointer-events-auto relative">
                        <h2 class="text-2xl sm:text-3xl md:text-5xl font-bold mb-3 text-white drop-shadow-lg">
                            Coming <span class="text-emerald-500 italic">Soon</span>
                        </h2>
                        <p class="max-w-md mx-auto text-slate-400 text-xs sm:text-sm md:text-base leading-relaxed">
                            This directory is currently under construction. <br class="hidden sm:block">
                            Please check back later for the latest updates.
                        </p>
                    </div>

                    <!-- Back to Home -->
                    <div class="mt-12 md:mt-16 pointer-events-auto">
                        <a href="/"
                            class="group flex items-center gap-3 text-emerald-500 font-mono text-[10px] md:text-xs uppercase tracking-[0.3em] hover:text-emerald-300 transition-all duration-300">
                            <span
                                class="opacity-30 group-hover:opacity-100 transform group-hover:-translate-x-1 transition-all">&gt;</span>
                            Back to Home
                            <span
                                class="opacity-30 group-hover:opacity-100 transform group-hover:translate-x-1 transition-all">&lt;</span>
                        </a>
                    </div>
                </main>
            </section>

        </div>

        <script src="script.js"></script>
        <script>
            const canvas = document.getElementById('noiseCanvas');
            const ctx = canvas.getContext('2d');
            let particles = [];
            let w, h;

            const config = {
                particleColor: 'rgba(21, 77, 65, 0.4)', // Using brand emerald
                particleCount: 1500,
                noiseSpeed: 0.8
            };

            function init() {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
                particles = [];

                // Adjust density based on screen size
                const count = w < 768 ? config.particleCount / 3 : config.particleCount;

                for (let i = 0; i < count; i++) {
                    particles.push({
                        x: Math.random() * w,
                        y: Math.random() * h,
                        size: Math.random() * 1.5,
                        vx: (Math.random() - 0.5) * config.noiseSpeed,
                        vy: (Math.random() - 0.5) * config.noiseSpeed,
                        alpha: Math.random()
                    });
                }
            }

            function drawNoise() {
                // Faint tail effect to simulate motion blur
                ctx.fillStyle = 'rgba(1, 12, 19, 0.2)';
                ctx.fillRect(0, 0, w, h);

                for (let p of particles) {
                    // Update position with random jitter
                    p.x += p.vx + (Math.random() - 0.5) * 0.5;
                    p.y += p.vy + (Math.random() - 0.5) * 0.5;

                    // Screen wrapping
                    if (p.x < 0) p.x = w;
                    if (p.x > w) p.x = 0;
                    if (p.y < 0) p.y = h;
                    if (p.y > h) p.y = 0;

                    // Occasional alpha flicker
                    if (Math.random() > 0.98) p.alpha = Math.random();

                    ctx.beginPath();
                    ctx.fillStyle = `rgba(21, 77, 65, ${p.alpha * 0.5})`;
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                    ctx.fill();
                }

                // High-frequency Grain Overlay
                // We draw a few random "pixels" every frame to simulate digital static
                for (let i = 0; i < 500; i++) {
                    const gx = Math.random() * w;
                    const gy = Math.random() * h;
                    ctx.fillStyle = Math.random() > 0.5 ? 'rgba(255,255,255,0.03)' : 'rgba(21,77,65,0.05)';
                    ctx.fillRect(gx, gy, 1, 1);
                }

                requestAnimationFrame(drawNoise);
            }

            window.addEventListener('resize', init);

            init();
            drawNoise();
        </script>

    </body>

</html>